# Glassdoor login
GLASSDOOR_EMAIL=your-email@example.com
GLASSDOOR_PASSWORD=your-password-here

# auto | google | indeed
# gmail addresses default to Google OAuth (avoids Indeed Cloudflare)
GLASSDOOR_LOGIN_METHOD=auto

# Preferred (documented 2026): capture once with Patchright, then reuse state
#   python main.py login
# Optional override path for storage_state JSON:
# GLASSDOOR_STATE_PATH=data/glassdoor_state.json

# Optional: Google Authenticator / TOTP secret for 2FA (base32)
# GLASSDOOR_TOTP_SECRET=

# Optional: Capsolver key for Indeed Cloudflare Turnstile
# CAPSOLVER_API_KEY=

# Strongly recommended: residential proxy (datacenter IPs stay on CF captcha)
# Required for: cloud VM login, and for --backend bff (curl_cffi BFF API)
# HTTPS_PROXY=http://user:pass@host:port
#
# Optional: pin curl_cffi Chrome fingerprint (default tries chrome136)
# CURL_CFFI_IMPERSONATE=chrome136

# Gemini API (question answers / LLM features)
# Used by Python enrich workers. On Vercel web app prefer AI Gateway / OIDC.
GEMINI_API_KEY=your-gemini-api-key-here

# ---------------------------------------------------------------------------
# Product / Vercel (Wave 1+ — ibpe-infra)
# Do NOT put HTTPS_PROXY, GLASSDOOR_*, Capsolver, cookies, or GEMINI_API_KEY
# in NEXT_PUBLIC_* or Vercel public client env.
# ---------------------------------------------------------------------------

# Neon Postgres (Marketplace) — replaces sunset @vercel/postgres
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Clerk end-user auth (Wave 2) — distinct from Glassdoor scrape login
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# AUTH_SECRET=

# Vercel Blob — raw artefacts / large exports (server + worker only)
# BLOB_READ_WRITE_TOKEN=

# Upstash Redis — cache, rate limits, job coordination (replaces sunset @vercel/kv)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Cron / worker enqueue auth for scheduled jobs
# CRON_SECRET=

# Optional AI Gateway (Vercel deployments); local workers may keep GEMINI_API_KEY
# AI_GATEWAY_API_KEY=
