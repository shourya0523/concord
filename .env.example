# Glassdoor login (scrape / dataset updates only — not product auth)
GLASSDOOR_EMAIL=your-email@example.com
GLASSDOOR_PASSWORD=your-password-here

# auto | google | indeed
# gmail addresses default to Google OAuth
GLASSDOOR_LOGIN_METHOD=auto

# Preferred dataset-update path (ADR 0006): Patchright headed login + manual captcha
#   python main.py login
# then reuse storage_state on batch:
#   python main.py batch --track IB --limit 1
# Optional override path for storage_state JSON:
# GLASSDOOR_STATE_PATH=data/glassdoor_state.json

# Optional: Google Authenticator / TOTP secret for 2FA (base32)
# GLASSDOOR_TOTP_SECRET=

# Optional: Capsolver key for Indeed Cloudflare Turnstile
# CAPSOLVER_API_KEY=

# Optional residential proxy (only if you still experiment with legacy --backend bff)
# Not required for the supported manual-captcha / Patchright path.
# HTTPS_PROXY=http://user:pass@host:port
# CURL_CFFI_IMPERSONATE=chrome136

# LLM stack — OpenRouter (docs/deployment/llm-stack.md). Server-only: never NEXT_PUBLIC_*.
# Without OPENROUTER_API_KEY every LLM path degrades: grading → deterministic,
# briefs/coaching → templates, voice transcription → 501 (type instead).
OPENROUTER_API_KEY=
# Primary tier (rubric grading judge). Set to Jev's OpenRouter slug; the
# default deepseek/deepseek-v4.1-flash is a placeholder.
# LLM_PRIMARY_MODEL=
# Small tier (RAG brief, simulator coaching) + automatic fallback for primary.
# Default deepseek/deepseek-v4-flash; alternatives z-ai/glm-4.7-flash, google/gemini-2.5-flash-lite
# LLM_SMALL_MODEL=deepseek/deepseek-v4-flash
# Embeddings (768-d, pgvector column in migration 033). Changing it requires `npm run embed:rag`.
# LLM_EMBED_MODEL=openai/text-embedding-3-small
# Voice-answer transcription
# LLM_STT_MODEL=openai/whisper-large-v3-turbo
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Attribution (HTTP-Referer); falls back to NEXT_PUBLIC_APP_URL
# OPENROUTER_APP_URL=
# Grader bake-off override for the primary tier (OpenRouter slug only)
# GRADER_MODEL=

# GEMINI_API_KEY is no longer used by the TypeScript stack (web, embed:rag,
# eval). The Python enrich worker has its own migration — see its docs.

# ---------------------------------------------------------------------------
# Product / monorepo (Wave 1+ — coordinate with ibpe-infra for Vercel pull)
# Do NOT prefix scrape secrets with NEXT_PUBLIC_
# ---------------------------------------------------------------------------

# Neon Postgres
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Neon Auth (Managed Better Auth) — Wave 2 product login (ADR 0006)
# Console: Project → Branch → Auth → Configuration
# NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-1.aws.neon.tech/neondb/auth
# Generate: openssl rand -base64 32
# NEON_AUTH_COOKIE_SECRET=
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin review queue (/admin/review, /api/admin/proposals) — server-only
# Comma list of Neon Auth emails allowed to review enrichment proposals.
# ADMIN_EMAILS=owner@example.com,reviewer@example.com
# Owner-level connection for staging/admin writes (concord_app has no grants there).
# ADMIN_DATABASE_URL=postgresql://owner:pass@host/db?sslmode=require

# Vercel Blob — raw artefacts / large exports
# BLOB_READ_WRITE_TOKEN=

# Upstash Redis — cache, rate limits, job coordination
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional Edge Config (feature flags at the edge)
# EDGE_CONFIG=

# Cron / worker auth for scheduled jobs (Vercel sends `Authorization: Bearer $CRON_SECRET`)
# CRON_SECRET=

# Reminders + leagues (plan 2026-09-23-001 Phase 6 / P7.3) — docs/deployment/notifications.md
# Everything is optional: without keys the senders no-op and the cron reports "skipped".
# Owner (BYPASSRLS) URL for the hourly /api/cron/notify run — it spans users, so it
# cannot use the RLS-scoped concord_app DATABASE_URL. Falls back to DATABASE_URL.
# CRON_DATABASE_URL=
# Email via Resend (server-only). From must be on a verified Resend domain.
# RESEND_API_KEY=
# NOTIFY_FROM_EMAIL="Concord <reminders@example.com>"
# NOTIFY_REPLY_TO=
# HMAC secret for one-click unsubscribe links (falls back to CRON_SECRET). openssl rand -base64 32
# NOTIFY_SIGNING_SECRET=
# Web Push (VAPID). Generate once: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:reminders@example.com
# Same value as VAPID_PUBLIC_KEY — the only public notification var.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Feature flags (optional overrides — defaults in packages/config)
# FLAG_PRODUCT_UI=false
# FLAG_NEON_AUTH=false
# FLAG_HYBRID_SEARCH=false
# FLAG_GEMINI_ENRICH=true
# FLAG_SCRAPE_BFF_DEFAULT=false
# FLAG_PUBLISH_SYNTHESISED=false
# FLAG_FIRM_TOPIC_HEAT=true
# FLAG_NOTIFICATIONS=true
# FLAG_LEAGUES=true
