# Worker host / Cloud Agents secrets (names only — no values).
# Copy to the worker environment; do not use NEXT_PUBLIC_ for any of these.

# Scrape (see AGENTS.md) — worker / Cloud Agents only; never NEXT_PUBLIC_*
GLASSDOOR_EMAIL=
GLASSDOOR_PASSWORD=
GLASSDOOR_LOGIN_METHOD=auto
# GLASSDOOR_TOTP_SECRET=
# GLASSDOOR_STATE_PATH=data/glassdoor_state.json
# CAPSOLVER_API_KEY=
HTTPS_PROXY=

# Enrich — OpenRouter is the single LLM gateway (ADR 0007). GEMINI_API_KEY is retired.
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LLM_SMALL_MODEL=deepseek/deepseek-v4-flash      # default for all enrichment (cheap)
# LLM_PRIMARY_MODEL=deepseek/deepseek-v4.1-flash  # "Jev" placeholder; only --tier primary / escalation
# LLM_FALLBACK_MODEL=google/gemini-2.5-flash-lite # OpenRouter `models` fallback; empty disables
# LLM_DEFAULT_TIER=small
# IBPE_ENRICH_LLM=1                               # 0 forces heuristic-only run-pipeline

# Publish / artefacts
# DATABASE_URL=
# BLOB_READ_WRITE_TOKEN=
# BLOB_BASE_PREFIX=concord-dev/
# CRON_SECRET=
