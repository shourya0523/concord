{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@ibpe/contracts": ["../contracts/src/index.ts"],
      "@ibpe/contracts/*": ["../contracts/src/*"]
    }
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"]
}
