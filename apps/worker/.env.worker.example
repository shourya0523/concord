# Worker host / Cloud Agents secrets (names only — no values).
# Copy to the worker environment; do not use NEXT_PUBLIC_ for any of these.

# Scrape (see AGENTS.md) — worker / Cloud Agents only; never NEXT_PUBLIC_*
GLASSDOOR_EMAIL=
GLASSDOOR_PASSWORD=
GLASSDOOR_LOGIN_METHOD=auto
# GLASSDOOR_TOTP_SECRET=
# GLASSDOOR_STATE_PATH=data/glassdoor_state.json
# CAPSOLVER_API_KEY=
HTTPS_PROXY=

# Enrich — OpenRouter is the single model gateway (ADR 0007). GEMINI_API_KEY is retired.
# Jev decides (taxonomy, signal topics, concept/mode routing, draft verification);
# the small chat model writes text only when a heuristic fails, always Jev-verified.
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_DECISIONS_URL=                       # default: origin of OPENROUTER_BASE_URL + /api/alpha/decisions
# LLM_DECISION_MODEL=typesafe/jev-1.13            # Jev (Decisions API); pin a version for stable thresholds
# JEV_AUTO_APPROVE=0.8                            # taxonomy: auto-approve when >= this AND rules agree (>= 0.9 alone)
# JEV_ACCEPT_CONFIDENCE=0.8                       # accept a small-model draft only if Jev says "supported" >= this
# LLM_SMALL_MODEL=deepseek/deepseek-v4-flash      # rubric / expansion / diagram drafts only (cheap)
# LLM_FALLBACK_MODEL=google/gemini-2.5-flash-lite # small tier `models` fallback; empty disables
# IBPE_ENRICH_LLM=1                               # 0 forces heuristic-only run-pipeline

# Publish / artefacts
# DATABASE_URL=
# BLOB_READ_WRITE_TOKEN=
# BLOB_BASE_PREFIX=concord-dev/
# CRON_SECRET=
